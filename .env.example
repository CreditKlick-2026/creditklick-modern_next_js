# Copy to .env.local — never commit real values.
MONGODB_URL=
NEXT_PUBLIC_API_URL=

# CreditKlick backend (owns partner integrations such as Great.Cards loans). Include /api/v1.
BACKEND_API_URL=https://api.creditklick.com/api/v1
# Same value as INTERNAL_PROXY_SECRET in the backend .env (lets the backend see the real customer IP)
INTERNAL_PROXY_SECRET=
